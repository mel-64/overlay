RUST_MIN_VER="1.91.0"
inherit cargo

DESCRIPTION="rustic - fast, encrypted, and deduplicated backups powered by Rust"
HOMEPAGE="https://github.com/rustic-rs/rustic"
SRC_URI="
	https://github.com/rustic-rs/rustic/archive/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="|| ( Apache-2.0 MIT )"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 BSD CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0
	MPL-2.0 Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="jemallocator +jq mimalloc mount +opentelemetry +prometheus rhai self-update +tui +webdav"

src_configure() {
	local myfeatures=(
		$(usev jemallocator)
		$(usev jq)
		$(usev mimalloc)
		$(usev mount)
		$(usev opentelemetry)
		$(usev prometheus)
		$(usev rhai)
		$(usev self-update)
		$(usev tui)
		$(usev webdav)
	)
	cargo_src_configure
}
