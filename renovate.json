{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "extractVersion": "^v?(?<version>.*)$",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)[^/]+\\.ebuild$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\s+# Current version: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/*.ebuild"],
      "automerge": false,
      "labels": ["ebuild-update"]
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      ".scripts/renovate/rename-ebuild.sh {{{packageFile}}} {{{newVersion}}}",
      ".scripts/renovate/update-cargo.sh {{{packageFile}}} {{{newVersion}}}",
      ".scripts/renovate/update-manifest.sh {{{packageFile}}} {{{newVersion}}}"
    ],
    "executionMode": "update",
    "installTools": {
      "python": {},
      "uv": {}
    }
  },
  "constraints": {
    "python": "3.14.7",
    "uv": ">=0.4"
  }
}
