{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)[^/]+\\.ebuild$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n# Current version: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/*.ebuild"],
      "automerge": false,
      "labels": ["ebuild-update"]
    }
  ],
  "prConcurrentLimit": 3,
  "rebaseWhen": "conflicted"
}
